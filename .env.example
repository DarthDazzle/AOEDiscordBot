# Required
DISCORD_API=your_discord_bot_token

# Text channel that gets the "who is in voice" roster message
STATUS_CHANNEL_ID=895733929808650311

# Game servers: compose file, or directory containing docker-compose.yml.
# When running the bot in docker, mount each path at the same location.
COMPOSE_FILE_VRISING=/media/mainStorage/games/vrising
COMPOSE_FILE_VALHEIM=/media/mainStorage/games/valheim
COMPOSE_FILE_ENSHROUDED=/media/mainStorage/games/enshrouded
COMPOSE_FILE_MINECRAFT=/media/mainStorage/games/minecraft
COMPOSE_FILE_BAROTRAUMA=/media/mainStorage/games/barotrauma
COMPOSE_FILE_TERRARIA=/media/mainStorage/games/terraria

# /skapa image generation, paid backend (about $0.045 per 512px image with
# gemini-3.1-flash-image). Key from https://aistudio.google.com/apikey.
# With a key, mentioned users' avatars are sent as character references.
#GEMINI_API_KEY=
#GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
#GEMINI_IMAGE_SIZE=512
# Paid images per ISO week (Mon-Sun), whole server and per user. 0 = no cap.
#IMAGE_WEEKLY_LIMIT=50
#IMAGE_USER_WEEKLY_LIMIT=0
# Max mentioned users whose avatars are used
#IMAGE_MAX_REFERENCES=4

# Free fallback (pollinations.ai), also used when Gemini fails or has no key.
# Without a pollinations key only text-to-image works (model flux, one request
# per 15 s). A free key from https://enter.pollinations.ai/keys enables avatar
# references (model klein).
#POLLINATIONS_API_KEY=
#IMAGE_MODEL=klein
#IMAGE_FALLBACK_MODEL=flux

# Seconds between taunts per user
#TAUNT_COOLDOWN=0.5
