# Required
DISCORD_API=your_discord_bot_token

# Text channel that gets the "who is in voice" roster message
STATUS_CHANNEL_ID=895733929808650311

# Game servers: compose file, or directory containing docker-compose.yml.
# When running the bot in docker, mount each path at the same location.
COMPOSE_FILE_VRISING=/media/mainStorage/games/vrising
COMPOSE_FILE_VALHEIM=/media/mainStorage/games/valheim
COMPOSE_FILE_ENSHROUDED=/media/mainStorage/games/enshrouded
COMPOSE_FILE_MINECRAFT=/media/mainStorage/games/minecraft
COMPOSE_FILE_BAROTRAUMA=/media/mainStorage/games/barotrauma
COMPOSE_FILE_TERRARIA=/media/mainStorage/games/terraria

# /skapa image generation. Optional: without a key only text-to-image works
# (model flux, one request per 15 s). A free key from
# https://enter.pollinations.ai/keys enables avatar references (model klein).
#POLLINATIONS_API_KEY=
#IMAGE_MODEL=klein
#IMAGE_FALLBACK_MODEL=flux
#IMAGE_MAX_REFERENCES=4

# Seconds between taunts per user
#TAUNT_COOLDOWN=0.5
